#!/bin/bash
# Wrapper for shell.online CLI tool ensuring auto-installation and execution

REAL_BIN="/root/.local/bin/shell"

if [ ! -x "$REAL_BIN" ]; then
  echo "[shell] Initializing shell.online CLI binary..."
  mkdir -p /root/.local/bin
  curl -fsSL https://shell.online/install | sh >/dev/null 2>&1 || true
fi

if [ ! -x "$REAL_BIN" ]; then
  if command -v shell >/dev/null 2>&1; then
    exec shell "$@"
  fi
  echo "Error: shell binary not found. Run 'curl -fsSL https://shell.online/install | sh' to install."
  exit 1
fi

exec "$REAL_BIN" "$@"
