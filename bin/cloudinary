#!/bin/bash
# Get the absolute path of the directory containing this script
BIN_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_ROOT="$( dirname "$BIN_DIR" )"

# Set PYTHONPATH to include the local installation
export PYTHONPATH="$BIN_DIR/cloudinary_env/local/lib/python3.10/dist-packages":$PYTHONPATH

# Load CLOUDINARY_URL from .env
if [ -f "$PROJECT_ROOT/.env" ]; then
    export CLOUDINARY_URL=$(grep "^CLOUDINARY_URL=" "$PROJECT_ROOT/.env" | cut -d '=' -f2-)
fi

# Execute the binary
"$BIN_DIR/cloudinary_env/local/bin/cloudinary" "$@"
