#!/bin/sh
# Antigravity CLI Dynamic Wrapper
# Dynamically resolves and proxies to the installed agy binary across all environments

for candidate in \
  /tmp/bin/agy \
  "$PWD/.bin/agy" \
  "/app/applet/.bin/agy" \
  "/workspace/.bin/agy" \
  /usr/local/bin/agy \
  /usr/bin/agy; do
  if [ -x "$candidate" ] 2>/dev/null; then
    exec "$candidate" "$@"
  fi
done

echo "[Notice: Antigravity CLI binary is initializing in container... please retry in 5 seconds]" >&2
exit 127
